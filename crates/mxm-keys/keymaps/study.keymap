# The default: the key study of 2026-10-06 proposed it, making 26 known songs again with the
# language, as an experienced user would, and pricing every learnable layout for finger travel and
# comfortable chords, held and tapped; the owner tuned it by practice on 2026-10-08. For a hand
# resting ring finger on A, middle on S, index on D:
#
#   Q  SELECT     W  DUPLICATE  E  MOVE       R  MUSICAL
#   A  VALUE      S  COARSE     D  FINE       F  MICRO
#   Z  .          X  EXTENT     C  VIEW       V  ADD
#
# SELECT, DUPLICATE and MOVE together; VALUE in line with the step sizes it's used with most; ADD
# on V, beside paste and easy to hit; EXTENT on X; Z unused.

name = Key study, 2026-10-06

move = E
extent = X
value = A
select = Q
duplicate = W

musical = R
coarse = S
fine = D
micro = F

add = V

delete = Delete
ripple = Backspace
open = Enter
back = Escape
# The study put OUT on Caps Lock, which comes out 0.6 points cheaper, but a toolkit that reports
# Caps Lock only as a modifier can't see it pressed: Tab until the host reads it as a key.
out = Tab
# VIEW is on a key as well as Shift: Shift is only ever held, so a key is what makes VIEW tapped
# in sequence, as every other job is (the user, 2026-10-07).
view = C, Shift

# The host's keys, outside the language. The panels newDAWn opens and closes, on the number row:
panel.arrangement = 1
panel.notes = 2
panel.tracker = 3
panel.mixer = 4
panel.plugins = 5
panel.parameters = 6
# Note entry's piano, MXM Player's layout: the semitones up from C, then the octave.
note.keys = A, W, S, E, D, F, T, G, Y, H, U, J, K, O, L, P, Semicolon, Quote
note.octave-down = Z
note.octave-up = X

tap-arms = yes
one-arrow = no
timeout = off
