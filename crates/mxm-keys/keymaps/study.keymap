# The default: proposed by the key study of 2026-10-06, which made 26 known songs again with the
# language, as an experienced user would, and priced every learnable layout for finger travel and
# comfortable chords, held and tapped. Verbs on the top row, step sizes on the home row (held in
# chords), actions on the bottom row, for a hand resting ring finger on A, middle on S, index on D.
#
#   Q  SELECT     W  VALUE      E  MOVE       R  EXTENT
#   A  MUSICAL    S  COARSE     D  FINE       F  MICRO
#   Z  ADD        X  DUPLICATE  C  VIEW       V  .
#
# A starting point, tuned by practice. The first keys to try swapping, which the study's variants
# moved: MOVE and EXTENT (E, R), and VALUE and SELECT (W, Q).

name = Key study, 2026-10-06

move = E
extent = R
value = W
select = Q

musical = A
coarse = S
fine = D
micro = F

add = Z
duplicate = X

delete = Delete
ripple = Backspace
open = Enter
back = Escape
# The study put OUT on Caps Lock, which comes out 0.6 points cheaper, but a toolkit that reports
# Caps Lock only as a modifier can't see it pressed: Tab until the host reads it as a key.
out = Tab
# VIEW is on a key as well as Shift: Shift is only ever held, so a key is what makes VIEW tapped
# in sequence, as every other job is (the user, 2026-10-07).
view = C, Shift

tap-arms = yes
one-arrow = no
timeout = off
