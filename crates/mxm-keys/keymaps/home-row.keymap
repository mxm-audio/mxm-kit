# The 2026-10-05 notes' language with MOVE and VALUE on the home row, under the middle and index
# fingers, and the actions on the top row: the first comparison the notes ask for.
#
#   Q  SELECT     W  ADD        E  DUPLICATE  R  .
#   A  EXTENT     S  MOVE       D  VALUE      F  VIEW
#   Z  .          X  COARSE     C  FINE       V  MICRO
#
# A starting point to try, not a choice: the bindings are chosen from usage.

name = Verbs on the home row

move = S
extent = A
value = D

add = W
select = Q
duplicate = E

coarse = X
fine = C
micro = V

delete = Delete
ripple = Backspace
open = Enter
back = Escape
out = Tab
# VIEW is on a key as well as Shift: Shift is only ever held, so a key is what makes VIEW tapped
# in sequence, as every other job is (the user, 2026-10-07).
view = F, Shift

# The host's keys, outside the language. The panels newDAWn opens and closes, on the number row:
panel.arrangement = 1
panel.notes = 2
panel.tracker = 3
panel.mixer = 4
panel.plugins = 5
panel.parameters = 6
# Note entry's piano, MXM Player's layout: the semitones up from C, then the octave.
note.keys = A, W, S, E, D, F, T, G, Y, H, U, J, K, O, L, P, Semicolon, Quote
note.octave-down = Z
note.octave-up = X

tap-arms = yes
one-arrow = no
timeout = off
